{% set s = strings[lang] %}
{% from "partials/icons.njk" import usaFlag, ukFlag, israelFlag, sunIcon, moonIcon %}
<a class="skip-link" href="#main-content">{{ s.skipToContent }}</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="{{ '/' | localize(lang) | url }}">{{ site.lawyerName_he if lang == 'he' else site.lawyerName_en }}</a>

    <nav class="main-nav" aria-label="{{ s.nav.home }}">
      <ul class="main-nav__list">
        <li><a href="{{ '/about/' | localize(lang) | url }}" {% if navKey == 'about' %}aria-current="page"{% endif %}>{{ s.nav.about }}</a></li>
        <li class="has-dropdown">
          <a href="{{ '/practice-areas/' | localize(lang) | url }}" {% if navKey == 'practiceAreas' %}aria-current="page"{% endif %}>{{ s.nav.practiceAreas }}</a>
          <button type="button" class="dropdown-caret" data-dropdown-toggle aria-expanded="false" aria-controls="practice-areas-menu" aria-haspopup="true" aria-label="{{ s.nav.practiceAreas }}">
            <span class="dropdown-caret__arrow" aria-hidden="true"></span>
          </button>
          <ul class="dropdown-menu" id="practice-areas-menu" data-dropdown-menu>
            {% for area in practiceAreas %}
            <li><a href="{{ ('/practice-areas/' ~ area.slug ~ '/') | localize(lang) | url }}">{{ area.title_he if lang == 'he' else area.title_en }}</a></li>
            {% endfor %}
          </ul>
        </li>
        <li><a href="{{ '/cases/' | localize(lang) | url }}" {% if navKey == 'cases' %}aria-current="page"{% endif %}>{{ s.nav.cases }}</a></li>
        <li><a href="{{ '/clients/' | localize(lang) | url }}" {% if navKey == 'clients' %}aria-current="page"{% endif %}>{{ s.nav.clients }}</a></li>
        <li><a href="{{ '/contact/' | localize(lang) | url }}" {% if navKey == 'contact' %}aria-current="page"{% endif %}>{{ s.nav.contact }}</a></li>
      </ul>
    </nav>

    <div class="header-controls">
      <a class="btn btn--primary" href="{{ '/contact/' | localize(lang) | url }}">{{ s.cta.headerButton }}</a>
      <a class="lang-switch header-controls__mobile-hide" href="{{ altHref | url }}" hreflang="{{ s.otherLangCode }}" lang="{{ s.otherLangCode }}" aria-label="{{ s.otherLangLabel }}">
        {% if s.otherLangCode == 'en' %}
          {{ usaFlag() }}<span class="lang-switch__sep" aria-hidden="true">/</span>{{ ukFlag() }}
        {% else %}
          {{ israelFlag() }}
        {% endif %}
      </a>
      <button type="button" class="icon-toggle header-controls__mobile-hide" data-theme-toggle data-label-to-light="{{ s.theme.toggleToLight }}" data-label-to-dark="{{ s.theme.toggleToDark }}" aria-label="{{ s.theme.toggleToDark }}">
        {{ sunIcon() }}
        {{ moonIcon() }}
      </button>
      <button type="button" class="hamburger" aria-label="{{ s.mobileMenu.open }}" aria-expanded="false" aria-controls="mobile-nav">
        <span aria-hidden="true">&#9776;</span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav">
  <div class="mobile-nav__top">
    <span class="brand">{{ site.lawyerName_he if lang == 'he' else site.lawyerName_en }}</span>
    <button type="button" class="hamburger mobile-nav__close" aria-label="{{ s.mobileMenu.close }}">
      <span aria-hidden="true">&#10005;</span>
    </button>
  </div>
  <div class="mobile-nav__quick-controls">
    <button type="button" class="icon-toggle" data-theme-toggle data-label-to-light="{{ s.theme.toggleToLight }}" data-label-to-dark="{{ s.theme.toggleToDark }}" aria-label="{{ s.theme.toggleToDark }}">
      {{ sunIcon() }}
      {{ moonIcon() }}
    </button>
    <a class="lang-switch" href="{{ altHref | url }}" hreflang="{{ s.otherLangCode }}" lang="{{ s.otherLangCode }}" aria-label="{{ s.otherLangLabel }}">
      {% if s.otherLangCode == 'en' %}
        {{ usaFlag() }}<span class="lang-switch__sep" aria-hidden="true">/</span>{{ ukFlag() }}
      {% else %}
        {{ israelFlag() }}
      {% endif %}
    </a>
  </div>
  <ul class="mobile-nav__list">
    <li><a href="{{ '/about/' | localize(lang) | url }}">{{ s.nav.about }}</a></li>
    <li class="has-dropdown">
      <div class="mobile-nav__item-row">
        <a href="{{ '/practice-areas/' | localize(lang) | url }}">{{ s.nav.practiceAreas }}</a>
        <button type="button" class="dropdown-caret" data-dropdown-toggle aria-expanded="false" aria-controls="mobile-practice-areas-menu" aria-haspopup="true" aria-label="{{ s.nav.practiceAreas }}">
          <span class="dropdown-caret__arrow" aria-hidden="true"></span>
        </button>
      </div>
      <ul class="mobile-submenu" id="mobile-practice-areas-menu" data-dropdown-menu>
        {% for area in practiceAreas %}
        <li><a href="{{ ('/practice-areas/' ~ area.slug ~ '/') | localize(lang) | url }}">{{ area.title_he if lang == 'he' else area.title_en }}</a></li>
        {% endfor %}
      </ul>
    </li>
    <li><a href="{{ '/cases/' | localize(lang) | url }}">{{ s.nav.cases }}</a></li>
    <li><a href="{{ '/clients/' | localize(lang) | url }}">{{ s.nav.clients }}</a></li>
    <li><a href="{{ '/contact/' | localize(lang) | url }}">{{ s.nav.contact }}</a></li>
  </ul>
  <a class="btn btn--primary" style="margin-top:2rem" href="{{ '/contact/' | localize(lang) | url }}">{{ s.cta.headerButton }}</a>
</div>
