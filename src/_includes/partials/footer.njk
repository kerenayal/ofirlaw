{% set s = strings[lang] %}
{% from "partials/icons.njk" import phoneIcon, mobileIcon, faxIcon, emailIcon %}
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="brand" style="color:var(--color-text)">{{ site.lawyerName_he if lang == 'he' else site.lawyerName_en }}</p>
      <p class="footer-tagline">{{ s.footer.tagline }}</p>
    </div>
    <div>
      <h3 style="font-size:1rem">{{ s.nav.home }}</h3>
      <ul class="site-footer__list">
        <li><a href="{{ '/about/' | localize(lang) | url }}">{{ s.nav.about }}</a></li>
        <li><a href="{{ '/practice-areas/' | localize(lang) | url }}">{{ s.nav.practiceAreas }}</a></li>
        <li><a href="{{ '/cases/' | localize(lang) | url }}">{{ s.nav.cases }}</a></li>
        <li><a href="{{ '/clients/' | localize(lang) | url }}">{{ s.nav.clients }}</a></li>
        <li><a href="{{ '/contact/' | localize(lang) | url }}">{{ s.nav.contact }}</a></li>
      </ul>
    </div>
    <div>
      <h3 style="font-size:1rem">{{ s.nav.contact }}</h3>
      <ul class="site-footer__list">
        <li>{{ site.address_he if lang == 'he' else site.address_en }}</li>
        <li class="contact-line">{{ phoneIcon() }}{{ s.contactLabels.phone }}: <a href="tel:{{ site.phoneHref }}"><bdi dir="ltr">{{ site.phone }}</bdi></a></li>
        <li class="contact-line">{{ mobileIcon() }}{{ s.contactLabels.mobile }}: <a href="tel:{{ site.mobileHref }}"><bdi dir="ltr">{{ site.mobile }}</bdi></a></li>
        <li class="contact-line">{{ faxIcon() }}{{ s.contactLabels.fax }}: <bdi dir="ltr">{{ site.fax }}</bdi></li>
        <li class="contact-line">{{ emailIcon() }}<a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
      </ul>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <span><bdi dir="ltr">&copy; {{ currentYear }} {{ site.lawyerName_en }}</bdi> &mdash; {{ s.footer.rights }}.</span>
    <span class="site-footer__legal-links">
      <a href="{{ '/disclaimer/' | localize(lang) | url }}">{{ s.footer.disclaimerTitle }}</a>
      <a href="{{ '/accessibility/' | localize(lang) | url }}">{{ s.footer.accessibilityStatement }}</a>
      <a href="{{ '/privacy-policy/' | localize(lang) | url }}">{{ s.footer.privacyPolicy }}</a>
    </span>
    <span class="site-footer__credit">{{ s.footer.builtBy }} <a href="https://akbuilt.dev/" target="_blank" rel="noopener">AK Built</a></span>
  </div>
</footer>
