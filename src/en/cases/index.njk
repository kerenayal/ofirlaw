---
layout: layouts/base.njk
lang: en
navKey: cases
altHref: /cases/
title: "Selected Cases & Professional Experience | Ofir Omer, Adv."
description: "Selected cases by practice area: civil and commercial litigation, real estate, labor law, and defamation."
---
<section class="page-header container">
  <span class="eyebrow">Professional Experience</span>
  <h1>Selected Cases & Professional Experience</h1>
</section>

<section class="section">
  <div class="container">
    <div class="case-filters" data-case-filters>
      <button type="button" class="is-active" data-filter="all">All</button>
      {% for cat in caseCategories | sort(attribute="field_en") %}
      <button type="button" data-filter="{{ cat.category }}">{{ cat.field_en }}</button>
      {% endfor %}
    </div>

    <div class="grid" data-case-grid>
      {% for item in cases %}
      <article class="card case-card" data-category="{{ item.category }}">
        <span class="case-card__field">{{ item.field_en }}</span>
        <h2 class="card__title">{{ item.title_en }}</h2>
        <p>{{ item.summary_en }}</p>
        <a class="card__link" href="{{ ('/en/cases/' ~ item.slug ~ '/') | url }}">{{ strings.en.cta.readMore }}</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container inline-cta">
    <p>{{ strings.en.cta.inlineCta }}</p>
    <a class="btn btn--primary" href="{{ '/en/contact/' | url }}">Contact Us</a>
  </div>
</section>
