---
layout: layouts/base.njk
lang: en
navKey: practiceAreas
pagination:
  data: practiceAreas
  size: 1
  alias: area
permalink: "/en/practice-areas/{{ area.slug }}/"
eleventyComputed:
  title: "{{ area.title_en }} | Ofir Omer, Adv."
  description: "{{ area.short_en }}"
  altHref: "/practice-areas/{{ area.slug }}/"
---
<section class="page-header container">
  <span class="eyebrow">Practice Areas</span>
  <h1>{{ area.title_en }}</h1>
</section>

<section class="section">
  <div class="container prose">
    {{ area.body_en | paragraphs | safe }}
    {% for section in area.sections %}
    <h2>{{ section.title_en }}</h2>
    {{ section.body_en | paragraphs | safe }}
    {% if section.list_en %}
    <ul>
      {% for item in section.list_en %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if section.body_after_en %}
    {{ section.body_after_en | paragraphs | safe }}
    {% endif %}
    {% endfor %}
    <a class="card__link" href="{{ '/en/practice-areas/' | url }}">{{ strings.en.cta.backToPracticeAreas }}</a>
  </div>
</section>

<section class="section section--alt">
  <div class="container inline-cta">
    <p>{{ strings.en.cta.inlineCta }}</p>
    <a class="btn btn--primary" href="{{ '/en/contact/' | url }}">Contact Us</a>
  </div>
</section>
