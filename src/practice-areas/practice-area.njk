---
layout: layouts/base.njk
lang: he
navKey: practiceAreas
pagination:
  data: practiceAreas
  size: 1
  alias: area
  addAllPagesToCollections: true
permalink: "/practice-areas/{{ area.slug }}/"
eleventyComputed:
  title: "{{ area.title_he }} | אופיר עומר, עורכי דין"
  description: "{{ area.short_he }}"
  altHref: "/en/practice-areas/{{ area.slug }}/"
---
<section class="page-header container">
  <span class="eyebrow">תחומי עיסוק</span>
  <h1>{{ area.title_he }}</h1>
</section>

<section class="section">
  <div class="container prose">
    {{ area.body_he | paragraphs | safe }}
    {% for section in area.sections %}
    <h2>{{ section.title_he }}</h2>
    {{ section.body_he | paragraphs | safe }}
    {% if section.list_he %}
    <ul>
      {% for item in section.list_he %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if section.body_after_he %}
    {{ section.body_after_he | paragraphs | safe }}
    {% endif %}
    {% endfor %}
    <a class="card__link" href="{{ '/practice-areas/' | url }}">{{ strings.he.cta.backToPracticeAreas }}</a>
  </div>
</section>

<section class="section section--alt">
  <div class="container inline-cta">
    <p>{{ strings.he.cta.inlineCta }}</p>
    <a class="btn btn--primary" href="{{ '/contact/' | url }}">צרו קשר</a>
  </div>
</section>
