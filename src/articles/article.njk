---
layout: layouts/base.njk
lang: he
navKey: articles
pagination:
  data: articles
  size: 1
  alias: article
permalink: "/articles/{{ article.slug }}/"
eleventyComputed:
  title: "{{ article.title_he }} | עו\"ד אופיר עומר"
  description: "{{ article.summary_he }}"
  altHref: "/en/articles/{{ article.slug }}/"
---
<section class="page-header container">
  <span class="eyebrow">{{ article.categoryLabel_he }}</span>
  <h1>{{ article.title_he }}</h1>
  <time datetime="{{ article.date | isoDate }}">{{ article.date | dateHe }}</time>
</section>

<section class="section">
  <div class="container prose">
    {{ article.content_he | paragraphs | safe }}
    <p><a class="card__link" href="{{ '/articles/' | url }}">{{ strings.he.cta.backToArticles }}</a></p>
  </div>
</section>

<section class="section section--alt">
  <div class="container inline-cta">
    <p>{{ strings.he.cta.inlineCta }}</p>
    <a class="btn btn--primary" href="{{ '/contact/' | url }}">צרו קשר</a>
  </div>
</section>
