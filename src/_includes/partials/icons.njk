{% macro phoneIcon() %}
<svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M4 4c0 9 7 16 16 16v-3.3a1 1 0 0 0-.8-1l-3-.6a1 1 0 0 0-1 .3l-1.2 1.3a13 13 0 0 1-6.7-6.7l1.3-1.2a1 1 0 0 0 .3-1l-.6-3a1 1 0 0 0-1-.8H4Z"/>
</svg>
{% endmacro %}

{% macro mobileIcon() %}
<svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <rect x="7" y="2" width="10" height="20" rx="2"/>
  <line x1="11" y1="18" x2="13" y2="18"/>
</svg>
{% endmacro %}

{% macro faxIcon() %}
