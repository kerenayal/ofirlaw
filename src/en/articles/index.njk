---
layout: layouts/base.njk
lang: en
navKey: articles
altHref: /articles/
title: "Articles & Insights | Ofir Omer, Adv."
description: "Professional insights on litigation, real estate, contracts, corporate matters, and property management."
---
<section class="page-header container">
  <span class="eyebrow">Knowledge & Expertise</span>
  <h1>Articles & Insights</h1>
</section>

<section class="section">
  <div class="container grid">
    {% for article in articles %}
    <article class="card article-card">
      <time datetime="{{ article.date | isoDate }}">{{ article.date | dateEn }}</time>
      <h2 class="card__title">{{ article.title_en }}</h2>
      <p>{{ article.summary_en }}</p>
      <a class="card__link" href="/en/articles/{{ article.slug }}/">{{ strings.en.cta.readMore }}</a>
    </article>
    {% endfor %}
  </div>
</section>

<section class="section section--alt">
  <div class="container inline-cta">
    <p>{{ strings.en.cta.inlineCta }}</p>
    <a class="btn btn--primary" href="/en/contact/">Contact Us</a>
  </div>
</section>
