{% set s = strings[lang] %}
{% set pageUrl = page.url | url %}
{% set altHrefUrl = altHref | url %}
<!doctype html>
<html lang="{{ lang }}" dir="{{ s.dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ pageUrl }}">
  <link rel="alternate" hreflang="he" href="{{ site.url }}{{ pageUrl if lang == 'he' else altHrefUrl }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ altHrefUrl if lang == 'he' else pageUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ pageUrl if lang == 'he' else altHrefUrl }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ site.url }}{{ site.ogImage | url }}">
  <meta property="og:locale" content="{{ 'he_IL' if lang == 'he' else 'en_US' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage | url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="{{ '/styles/main.css' | url }}">

  <script>
    (function () {
      try {
        var theme = localStorage.getItem("ofirlaw-theme");
        if (theme) document.documentElement.setAttribute("data-theme", theme);
        var a11y = JSON.parse(localStorage.getItem("ofirlaw-a11y") || "{}");
        if (a11y.fontScale) document.documentElement.style.setProperty("--font-scale", a11y.fontScale);
        if (a11y.contrast) document.documentElement.setAttribute("data-contrast", "high");
        if (a11y.underline) document.documentElement.setAttribute("data-underline-links", "true");
        if (a11y.motion) document.documentElement.setAttribute("data-motion", "reduce");
      } catch (e) {}
    })();
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Attorney",
    "name": "{{ (site.lawyerName_he if lang == 'he' else site.lawyerName_en) | safe }}",
    "url": "{{ site.url }}",
    "image": "{{ site.url }}{{ site.portraitLarge | url }}",
    "telephone": "{{ site.phoneHref }}",
    "faxNumber": "{{ site.fax }}",
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ (site.streetAddress_he if lang == 'he' else site.streetAddress_en) | safe }}",
      "addressLocality": "{{ (site.addressLocality_he if lang == 'he' else site.addressLocality_en) | safe }}",
      "addressCountry": "IL"
    },
    "areaServed": "IL",
    "knowsLanguage": ["he", "en"]
  }
  </script>
</head>
<body>
  {% include "partials/header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/whatsapp-float.njk" %}
  {% include "partials/a11y-widget.njk" %}

  <script src="{{ '/scripts/main.js' | url }}"></script>
  <script src="{{ '/scripts/a11y-widget.js' | url }}"></script>
</body>
</html>
